# Токен бота от BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ID чата для хранения загруженных видео (получить через @userinfobot)
# Можно использовать приватный канал, куда бот добавлен как администратор
ARCHIVE_CHAT_ID=-1001234567890

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# TTL кэша file_id в секундах (по умолчанию 3600 = 1 час)
CACHE_TTL=3600
